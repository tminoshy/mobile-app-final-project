# Run tool/fetch_backend.sh first. Backend source and its contract require validation.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /source
COPY backend/ .
RUN mvn --batch-mode -DskipTests package && find target -maxdepth 1 -name '*.jar' ! -name '*original*' -exec cp {} /app.jar \;
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app.jar app.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
